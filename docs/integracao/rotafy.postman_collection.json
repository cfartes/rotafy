        },
        {
          "name": "Criar viagem ida e volta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/trips",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_key\": \"{{operation_key_trip}}\",\n  \"name\": \"Passeio Blumenau e Navegantes\",\n  \"destination\": \"Navegantes\",\n  \"mode\": \"round_trip\",\n  \"price_cents\": 12000,\n  \"legs\": [\n    {\n      \"origin\": \"Blumenau\",\n      \"destination\": \"Navegantes\",\n      \"origin_city_id\": 4202404,\n      \"destination_city_id\": 4211306,\n      \"origin_uf\": \"SC\",\n      \"destination_uf\": \"SC\",\n      \"origin_address\": \"Endereco do embarque em Blumenau\",\n      \"destination_address\": \"Endereco da chegada em Navegantes\",\n      \"starts_at\": \"2026-12-10T08:00:00-03:00\",\n      \"ends_at\": \"2026-12-10T09:30:00-03:00\",\n      \"stops\": []\n    },\n    {\n      \"origin\": \"Navegantes\",\n      \"destination\": \"Blumenau\",\n      \"origin_city_id\": 4211306,\n      \"destination_city_id\": 4202404,\n      \"origin_uf\": \"SC\",\n      \"destination_uf\": \"SC\",\n      \"origin_address\": \"Endereco do retorno em Navegantes\",\n      \"destination_address\": \"Endereco da chegada em Blumenau\",\n      \"starts_at\": \"2026-12-10T17:00:00-03:00\",\n      \"ends_at\": \"2026-12-10T18:30:00-03:00\",\n      \"stops\": []\n    }\n  ],\n  \"vehicles\": [\n    {\n      \"vehicle_id\": \"{{vehicle_id}}\",\n      \"driver_ids\": [\n        \"{{driver_id}}\"\n      ],\n      \"guide_ids\": []\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  " const trip=pm.response.json(); pm.collectionVariables.set('trip_id',trip.id);",
                  " const legs=[...trip.legs].sort((a,b)=>a.position-b.position);",
                  " pm.collectionVariables.set('leg_id',legs[0].id); pm.collectionVariables.set('return_leg_id',legs[1].id);",
                  " pm.collectionVariables.set('allocation_id',trip.vehicles[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar disponibilidade",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/trips/{{trip_id}}/availability",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_size\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Criar reserva confirmada (pode gerar mensagem)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/trips/{{trip_id}}/reservations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_key\": \"{{operation_key_reservation}}\",\n  \"contact_name\": \"Responsavel Exemplo\",\n  \"phone\": \"+5511999999999\",\n  \"status\": \"confirmed\",\n  \"allocation_id\": \"{{allocation_id}}\",\n  \"passengers\": [\n    {\n      \"full_name\": \"Passageiro Exemplo\",\n      \"is_foreign\": false,\n      \"under_five\": false\n    }\n  ],\n  \"journeys\": [\n    {\n      \"leg_id\": \"{{leg_id}}\",\n      \"boarding_position\": 0,\n      \"dropoff_position\": 1,\n      \"boarding_location\": {\n        \"name\": \"Hotel Exemplo\",\n        \"address\": \"Endereco completo do hotel em Blumenau\",\n        \"complement\": \"Recepcao\",\n        \"order\": 1\n      }\n    },\n    {\n      \"leg_id\": \"{{return_leg_id}}\",\n      \"boarding_position\": 0,\n      \"dropoff_position\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('reservation_id',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhes da reserva",
          "request": {
            "method": "GET",
            "header": [
