    {
      "name": "03 — Bilhete individual",
      "item": [
        {
          "name": "Emitir bilhetes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/reservations/{{reservation_id}}/tickets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  " const issued=pm.response.json().issued;",
                  " const ticket=issued.find(t=>t.leg_id===pm.collectionVariables.get('leg_id')) || issued[0];",
                  " if (ticket) { pm.collectionVariables.set('ticket_id',ticket.id); pm.collectionVariables.set('ticket_token',ticket.token); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Relacionar ticket_id ao passenger_id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/reservations/{{reservation_id}}/tickets"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code===200) {",
                  " const ticket=pm.response.json().find(t=>t.id===pm.collectionVariables.get('ticket_id'));",
                  " if(ticket) pm.collectionVariables.set('passenger_id',ticket.passenger_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar link do bilhete por WhatsApp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/tickets/{{ticket_id}}/whatsapp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_key\": \"{{operation_key_ticket}}\",\n  \"token\": \"{{ticket_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar fila de mensagens",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/reservations/{{reservation_id}}/whatsapp"
          }
        }
      ]
    },
    {
      "name": "04 — Reprodução da operação do APK (usuário atribuído)",
      "item": [
        {
          "name": "Login do motorista/guia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
