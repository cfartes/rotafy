  "item": [
    {
      "name": "01 — Preparação administrativa opcional (requer admin)",
      "item": [
        {
          "name": "Login administrador da empresa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"{{company}}\",\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const cookie = pm.response.headers.all().find(h => h.key.toLowerCase() === 'set-cookie' && h.value.startsWith('rotafy_csrf='));",
                  "  if (cookie) pm.collectionVariables.set('csrf', decodeURIComponent(cookie.value.split(';')[0].slice('rotafy_csrf='.length)));",
                  "  const user=pm.response.json(); pm.collectionVariables.set('operator_id',user.id); pm.collectionVariables.set('company_id',user.company_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar motorista (ou preencher driver_id existente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Motorista Exemplo\",\n  \"email\": \"motorista@example.com\",\n  \"password\": \"{{driver_password}}\",\n  \"role\": \"driver\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('driver_id',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar veículo (ou preencher vehicle_id existente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/vehicles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Onibus Exemplo\",\n  \"plate\": \"ABC1D23\",\n  \"capacity\": 46,\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) pm.collectionVariables.set('vehicle_id',pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
