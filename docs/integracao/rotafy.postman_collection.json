              }
            ],
            "url": "{{base_url}}/trips/{{trip_id}}/vehicles/{{allocation_id}}/legs/{{leg_id}}/boarding",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation_key\": \"{{operation_key_disembark}}\",\n  \"passenger_id\": \"{{passenger_id}}\",\n  \"expected_version\": {{presence_version}},\n  \"action\": \"disembark\",\n  \"device_id\": \"aparelho-exemplo-01\",\n  \"offline\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(pm.response.code===201) pm.collectionVariables.set('presence_version',pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar eventos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/trips/{{trip_id}}/vehicles/{{allocation_id}}/legs/{{leg_id}}/boarding-history"
          }
        },
        {
          "name": "Registrar chegada sem GPS disponível",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf}}"
              }
            ],
            "url": "{{base_url}}/trips/{{trip_id}}/vehicles/{{allocation_id}}/legs/{{leg_id}}/journey",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\",\n  \"arrival_location\": {\n    \"status\": \"unavailable\",\n    \"reason\": \"position_unavailable\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "05 — Distribuição Android",
      "item": [
        {
          "name": "Consultar versão APK publicada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/public/mobile-version?package_id=br.com.nexusdataanalytics.rotafy"
          }
        }
      ]
    }
  ]
}
