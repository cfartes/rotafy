# Copiar para .env.production; não reutilizar as credenciais locais.
# Senhas dos bancos: 64 caracteres hexadecimais, para uso seguro nas URLs.
RELEASE=2026-10-06-v1
POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
PLATFORM_DB_PASSWORD=CHANGE_ME
BOOTSTRAP_EMAIL=admin@nexusdataanalytics.com.br
BOOTSTRAP_PASSWORD=CHANGE_ME
# Preencher conforme diagnostico do Traefik existente.
TRAEFIK_NETWORK=CHANGE_ME
TRAEFIK_HTTPS_ENTRYPOINT=CHANGE_ME
TRAEFIK_CERTRESOLVER=CHANGE_ME
TRAEFIK_TRUSTED_IPS=CHANGE_ME
# Resend: remetente de domínio verificado. Deixar vazio desativa envio.
RESEND_API_KEY=
EMAIL_FROM=
